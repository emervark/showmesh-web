# Prettier's default scope is the whole repository, and `npm run format` is
# `prettier --write .`, so anything not excluded here gets rewritten. The last
# unguarded run touched forty-odd files that nobody meant to change.

# Build output and dependencies. Prettier skips node_modules on its own but
# not these, and it does not read .gitignore.
dist/
.astro/
node_modules/

# The manual is a separate VitePress project with its own package.json and its
# own conventions; the root formatter has no business reaching into it. More
# importantly, eight of its pages carry <!-- generated:… --> blocks that
# scripts/sync-reference.mjs replaces verbatim from the application's
# registries. Prettier realigns markdown tables, so formatting those pages
# would put the two tools in a permanent argument and bury real upstream drift
# in the churn.
manual/

# Supplied reference material, not source. Reformatting a document whose rules
# are mandatory (AGENTS.md points at the design principles) produces diff noise
# in the one place a clean history is worth most.
Showmesh_UI_standalone.html
SHOWMESH_UI_UX_DESIGN_PRINCIPLES.md
SHOWMESH_WEBSITE_CREATIVE_DIRECTION.md
SHOWMESH_WEBSITE_SPEC.md
AGENTS.md

# Generated by npm; never hand-formatted.
package-lock.json
