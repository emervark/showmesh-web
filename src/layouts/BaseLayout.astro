---
import '../styles/global.css';
const {
  title = 'Showmesh — Realtime show automation for Windows',
  description = 'Showmesh is a Windows-first realtime show automation application for theatres, concerts, immersive installations and live events.'
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/showmesh-application.png', Astro.site).href} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Showmesh" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Google tag (gtag.js) — GA4 property G-LKFYD8SLRB, stream showmesh.app.
         The same tag runs on manual.showmesh.app so both domains report into
         one stream; cross-domain linking is configured in the GA4 tag settings. -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LKFYD8SLRB"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-LKFYD8SLRB');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
