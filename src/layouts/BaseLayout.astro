---
import '../styles/global.css';
const {
  title = 'Showmesh - Realtime show automation for Windows',
  description = 'Showmesh is a Windows-first realtime show automation application for theatres, concerts, immersive installations and live events.'
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={new URL('/showmesh-application.png', Astro.site).href}
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Showmesh" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600&display=swap"
      rel="stylesheet"
    />
    <!-- Google tag (gtag.js). GT-KDQF8PWT is the loadable tag ID; it forwards to
         its destination G-LKFYD8SLRB, the GA4 stream for showmesh.app. The
         destination ID is not loadable on its own - googletagmanager.com answers
         404 for it. The manual runs the same tag, so both domains report into
         that one stream, with cross-domain linking set in its tag settings. -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=GT-KDQF8PWT"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'GT-KDQF8PWT');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
