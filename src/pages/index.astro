<script>
  // ---- Scroll reveal ----
  // Content is visible by default; only arm the hidden-then-animate behaviour
  // when JS + motion are available, so a script error never blanks the page.
  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;
  const reveals = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
  if (!reduceMotion && reveals.length) {
    document.documentElement.classList.add('js-reveal');
    // Reveal anything currently at or above the fold, then animate the rest in
    // as they are scrolled to. A scroll sweep self-heals sections that an
    // in-page anchor jump skipped over without ever intersecting.
    const sweep = () => {
      const limit = window.innerHeight * 0.88;
      for (const el of reveals) {
        if (
          !el.classList.contains('is-visible') &&
          el.getBoundingClientRect().top < limit
        ) {
          el.classList.add('is-visible');
        }
      }
    };
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        sweep();
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    window.addEventListener('hashchange', onScroll);
    sweep();
  }

  // ---- Hero transport demo ----
  const main = document.getElementById('main-content');
  type Cue = { num: string; name: string; dur: number; intent: string };
  let cues: Cue[] = [];
  try {
    cues = JSON.parse(main?.dataset.cues || '[]');
  } catch {
    cues = [];
  }

  const fmt = (sec: number) => {
    const s = Math.max(0, sec);
    const m = Math.floor(s / 60);
    const r = Math.floor(s % 60);
    return `${m}:${String(r).padStart(2, '0')}`;
  };

  const t = {
    curNum: document.querySelector<HTMLElement>('[data-cur-num]'),
    curName: document.querySelector<HTMLElement>('[data-cur-name]'),
    curElapsed: document.querySelector<HTMLElement>('[data-cur-elapsed]'),
    curDur: document.querySelector<HTMLElement>('[data-cur-dur]'),
    curBar: document.querySelector<HTMLElement>('[data-cur-bar]'),
    nextNum: document.querySelector<HTMLElement>('[data-next-num]'),
    nextName: document.querySelector<HTMLElement>('[data-next-name]'),
    nextIntent: document.querySelector<HTMLElement>('[data-next-intent]'),
    goTarget: document.querySelector<HTMLElement>('[data-go-target]'),
    stop: document.querySelector<HTMLElement>('[data-stop]'),
    curDot: document.querySelector<HTMLElement>('[data-transport] .dot')
  };

  if (cues.length) {
    let index = 1;
    let progress = 20;
    let paused = false;
    let panicReset = 0;
    // The editor hides STOP when nothing is live and dims the NOW block to
    // "nothing playing" — the box keeps its shape so the strip never jumps.
    let running = true;

    const render = () => {
      const len = cues.length;
      const nextIdx = (index + 1) % len;
      const cur = cues[index];
      const nxt = cues[nextIdx];

      // transport
      if (t.curNum) t.curNum.textContent = running ? cur.num : '';
      if (t.curName)
        t.curName.textContent = running ? cur.name : 'nothing playing';
      if (t.curElapsed)
        t.curElapsed.textContent = running
          ? fmt((progress / 100) * cur.dur)
          : '';
      if (t.curDur) t.curDur.textContent = running ? `/ ${fmt(cur.dur)}` : '';
      if (t.curBar) t.curBar.style.width = running ? `${progress}%` : '0%';
      if (t.curDot) t.curDot.classList.toggle('dot--idle', !running);
      if (t.nextNum) t.nextNum.textContent = nxt.num;
      if (t.nextName) t.nextName.textContent = nxt.name;
      if (t.nextIntent) t.nextIntent.textContent = nxt.intent;
      // GO always states what it will fire — the editor's armed-GO doctrine.
      if (t.goTarget) t.goTarget.textContent = `${nxt.num} · ${nxt.name}`;
      if (t.stop) t.stop.hidden = !running;
    };

    const advance = () => {
      index = (index + 1) % cues.length;
      progress = 0;
      running = true;
      render();
    };

    document.querySelector('[data-go]')?.addEventListener('click', advance);
    // STOP ends the live cue politely and leaves GO armed; PANIC is the hard
    // brake. Both leave the strip in the same shape the editor shows.
    document.querySelector('[data-stop]')?.addEventListener('click', () => {
      running = false;
      progress = 0;
      render();
    });
    document.querySelector('[data-panic]')?.addEventListener('click', () => {
      paused = true;
      running = false;
      progress = 0;
      render();
      window.clearTimeout(panicReset);
      panicReset = window.setTimeout(() => {
        paused = false;
      }, 1100);
    });

    window.setInterval(() => {
      if (paused || !running) return;
      progress += 1.6;
      if (progress >= 100) {
        advance();
      } else {
        render();
      }
    }, 140);

    render();
  }

  // ---- FAQ accordion ----
  document
    .querySelectorAll<HTMLElement>('[data-faq] .faq__item')
    .forEach((item) => {
      const btn = item.querySelector<HTMLButtonElement>('[data-faq-toggle]');
      const panel = item.querySelector<HTMLElement>('[data-faq-panel]');
      const icon = item.querySelector<HTMLElement>('.faq__icon');
      btn?.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', open ? 'false' : 'true');
        if (panel) panel.hidden = open;
        if (icon) icon.textContent = open ? '+' : '−';
      });
    });

  // ---- Early access form (Web3Forms) ----
  // The access key is public by design: it only routes submissions to the
  // email address it was registered with.
  const WEB3FORMS_ACCESS_KEY = '2f8eb683-3253-4574-9fc4-a5b506e4a130';
  const form = document.querySelector<HTMLFormElement>('[data-access-form]');
  const done = document.querySelector<HTMLElement>('[data-access-done]');
  const formError = document.querySelector<HTMLElement>('[data-access-error]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    // Web3Forms answers a multipart post with an HTML success page and only
    // answers a JSON post with JSON, so send JSON to keep res.json() valid.
    const payload: Record<string, FormDataEntryValue> = {
      access_key: WEB3FORMS_ACCESS_KEY,
      subject: 'Showmesh beta application',
      from_name: 'showmesh.app'
    };
    for (const [key, value] of new FormData(form)) payload[key] = value;
    if (formError) formError.hidden = true;
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Sending…';
    }
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json'
        },
        body: JSON.stringify(payload)
      });
      const json = await res.json();
      if (!json.success) throw new Error(json.message);
      form.hidden = true;
      if (done) done.hidden = false;
    } catch {
      if (formError) formError.hidden = false;
      if (btn) {
        btn.disabled = false;
        btn.textContent = 'Apply for the beta';
      }
    }
  });

  // ---- Live operator concept: scale + lazy-load the embedded workspace ----
  // The editor replica has a 1180px floor, so on wide screens the fixed
  // 1280x800 iframe is scaled to fit its container once it scrolls into view.
  // Narrow screens keep the link card instead and never load the embed.
  const BASE_W = 1280;
  const uiWindow = document.querySelector<HTMLElement>('[data-ui-window]');
  const uiFrame = document.querySelector<HTMLIFrameElement>('[data-ui-frame]');
  const uiViewport = document.querySelector<HTMLElement>('[data-ui-viewport]');
  const MIN_LIVE_WIDTH = 900;

  if (uiWindow && uiFrame && uiViewport) {
    let loaded = false;

    const fitFrame = () => {
      const scale = uiViewport.clientWidth / BASE_W;
      uiFrame.style.transform = `scale(${scale})`;
    };

    const goLive = () => {
      if (loaded || window.innerWidth < MIN_LIVE_WIDTH) return;
      loaded = true;
      fitFrame();
      uiFrame.src = '/showmesh-ui.html';
      uiFrame.addEventListener(
        'load',
        () => uiWindow.classList.add('is-live'),
        {
          once: true
        }
      );
    };

    if ('IntersectionObserver' in window) {
      const uiIo = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            goLive();
            uiIo.disconnect();
          }
        },
        { rootMargin: '200px' }
      );
      uiIo.observe(uiWindow);
    } else {
      goLive();
    }

    window.addEventListener('resize', () => {
      if (loaded) fitFrame();
    });
  }
</script>

