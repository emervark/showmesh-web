---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

const cues = [
  {
    num: '1',
    icon: '▶',
    name: 'House out',
    dur: 2,
    // The NEXT block's second line: what firing this cue will actually do.
    // Mirrors nextIntentText() in the editor's Transport.tsx.
    intent: 'manual · GO on the actor’s line'
  },
  {
    num: '2',
    icon: '▶',
    name: 'Opening video',
    dur: 45,
    intent: 'video · Output A'
  },
  {
    num: '3',
    icon: '⇄',
    name: 'Fade house to 0',
    dur: 3,
    intent: 'fades out 1 · House out'
  },
  {
    num: '4',
    icon: '◈',
    name: 'Send OSC /scene/2',
    dur: 1,
    intent: 'osc → Notch'
  }
];

// Resource → Action → Trigger, as the protocol actually ships it. The kinds
// come from protocol/protocol.schema.json (x-resource-kinds) and the triggers
// from ACTION_TRIGGER_KINDS; the design principles describe a wider model that
// the product has not reached yet, so it is named as intent, not inventory.
// Engine behaviour from the application's docs/STATUS.md. Everything here is
// on by default in v0.1.0-beta.6; the measured and unmeasured lines below the
// grid are quoted from the same file's soak record.
const engine = [
  {
    title: 'Composited once',
    copy: 'The project defines one canvas — width, height and frame rate. The program is composited once at that resolution and every output adapts it.'
  },
  {
    title: 'One thread owns the device',
    copy: 'A render coordinator owns the D3D11 device, context and swapchains, composites once and blits to each output, rather than a thread per output contending for the GPU.'
  },
  {
    title: 'GPU decode, with a way back',
    copy: 'Decoding runs on a dedicated NVDEC device, so several clips do not serialise against Present. A clip that decodes badly there is caught when it opens and falls back to CPU on its own.'
  },
  {
    title: 'Decoding toward the canvas',
    copy: 'Frames are decoded at the size the canvas actually needs — measured at roughly 4× on 4K down to 1080p.'
  }
];

const model = [
  {
    label: 'What can be controlled',
    color: 'var(--sm-live)',
    title: 'Resource',
    copy: 'Media — video, audio, images — plus text, an LTC generator and a live audio input. Resources live in the library and are reused across cues instead of being reconfigured in each one.',
    note: 'Four kinds today; the model is built to take more.'
  },
  {
    label: 'What changes',
    color: 'var(--sm-warning)',
    title: 'Action',
    copy: 'Three kinds. Command plays, pauses or stops. Set jumps a parameter to a value. Transition moves it over time on a curve. The engine clamps every value to the parameter registry.',
    note: 'command · set · transition'
  },
  {
    label: 'When it happens',
    color: 'var(--sm-ready)',
    title: 'Trigger',
    copy: 'Nine, and only nine — a closed set, so an action’s timing is always one of a handful of things you can read off the cue.',
    note: 'On Cue Start · On Play · On Cue Stop · On Finished · At Time · Timecode · OSC · MIDI CC · Manual'
  }
];

// The animatable parameter registry (protocol/params.schema.json), and the
// address shape that makes each one reachable from OSC while the show runs.
const params = [
  'Opacity',
  'Scale',
  'Position X',
  'Position Y',
  'Rotation',
  'Volume',
  'Pan'
];

// Operator behaviour a screenshot cannot show, from the application's own
// docs/MANUAL.md. Each line is something the editor does, not a quality it
// claims to have.
const operator = [
  {
    title: 'Aim, then fire',
    color: 'var(--sm-ready)',
    items: [
      'Space fires the armed cue, and the GO button names it: <b>GO — 5 · Score</b>.',
      'Clicking a cue arms it. <b>↑</b> and <b>↓</b> re-aim without firing.',
      'Esc is PANIC — but with a menu or the palette open, Esc only closes that. It cannot fall through and stop the show.',
      'STOP counts its blast radius before you press it: <b>STOP · 3</b>.'
    ]
  },
  {
    title: 'When something breaks',
    color: 'var(--sm-warning)',
    items: [
      'If the engine link drops, the clocks dim to <b>LAST KNOWN</b> and the progress bar freezes. A stopped clock is never mistaken for a paused show.',
      'The status bar reports what is true: <b>OSC ✕ not listening</b> when the bind failed, <b>MIDI not built</b> when it was compiled out.',
      '<b>LIVE</b> appears only when an input is actually listening.',
      'Warnings are a queue, not a slot — <b>+3 older</b> — so a burst never eats the first one.'
    ]
  },
  {
    title: 'Editing without fear',
    color: 'var(--sm-live)',
    items: [
      'Show mode locks editing and grows the transport for reading at a distance. Every blocked action explains itself.',
      'Selecting a cue is never firing it: prepare the next one without losing the live context.',
      'Del removes a whole selection as a single undo step.',
      'Deleting a resource takes two clicks: <b>used by 3 cues — delete?</b>'
    ]
  }
];

// Example mappings, not live state: the previous rows showed invented status
// ("locked", "3 active") on a page that says the status bar never claims what
// is not true. Values follow the reactive triggers in ACTION_TRIGGER_KINDS.
const mappings = [
  {
    kind: 'MIDI CC',
    color: 'var(--sm-live)',
    from: 'ch 1 · cc 21',
    to: '/cue/{id}/opacity',
    note: '0…127 mapped into the parameter’s range'
  },
  {
    kind: 'OSC',
    color: 'var(--sm-live)',
    from: '/scene/2  0.4',
    to: '/resource/{id}/volume',
    note: 'the float argument drives the value'
  },
  {
    kind: 'Timecode',
    color: 'var(--sm-warning)',
    from: '00:04:12:00',
    to: 'arms cue 7',
    note: 'freewheels through a dropout'
  }
];

const useCases = [
  {
    title: 'Theatre',
    copy: 'Run video, sound, graphics and control cues from a sequence that remains clear through rehearsals, changes and performance.'
  },
  {
    title: 'Concerts and touring',
    copy: 'Coordinate playback, visuals, outputs and external systems in a workflow designed for repeatable live operation.'
  },
  {
    title: 'Immersive installations',
    copy: 'Connect scheduled events, live inputs, sensors and realtime visual systems without reducing the installation to a fixed playlist.'
  },
  {
    title: 'Events and experiences',
    copy: 'Build dependable sequences for launches, conferences, exhibitions and branded experiences where multiple systems must act together.'
  },
  {
    title: 'Studios and creative technology',
    copy: 'Prototype and operate workflows that move between recorded media, realtime rendering and network control.'
  }
];

const integrations = [
  {
    name: 'Video and audio playback',
    status: 'Core',
    color: 'var(--sm-ready)'
  },
  { name: 'Images and text', status: 'Core', color: 'var(--sm-ready)' },
  { name: 'NDI and Spout output', status: 'Core', color: 'var(--sm-ready)' },
  { name: 'OSC and MIDI', status: 'Core', color: 'var(--sm-ready)' },
  { name: 'LTC / MTC timecode', status: 'Core', color: 'var(--sm-ready)' },
  { name: 'Notch Blocks', status: 'Planned', color: 'var(--sm-warning)' },
  {
    name: 'Art-Net / sACN (DMX)',
    status: 'Exploratory',
    color: 'var(--sm-text-faint)'
  },
  { name: 'HTTP / REST', status: 'Exploratory', color: 'var(--sm-text-faint)' },
  {
    name: 'Unreal Engine',
    status: 'Exploratory',
    color: 'var(--sm-text-faint)'
  },
  {
    name: 'TouchDesigner',
    status: 'Exploratory',
    color: 'var(--sm-text-faint)'
  }
];

const whySummary = [
  'Cue-first enough to learn quickly',
  'Extensible enough for complex automation',
  'Windows-first for modern production environments',
  'Designed around live operator confidence',
  'Built to connect media and realtime systems',
  'Honest about system state and development state'
];

type AccessField = {
  id: string;
  label: string;
  span: boolean;
  type: 'input' | 'textarea' | 'select';
  hint?: string;
  options?: string[];
};

const accessFields: AccessField[] = [
  { id: 'name', label: 'Name', span: false, type: 'input' },
  { id: 'email', label: 'Email', span: false, type: 'input' },
  {
    id: 'company',
    label: 'Company, venue or freelance',
    span: false,
    type: 'input'
  },
  { id: 'role', label: 'Role', span: false, type: 'input' },
  {
    id: 'machine',
    label: 'Windows version + GPU',
    span: false,
    type: 'input',
    hint: 'For example: Windows 11 24H2, RTX 4070'
  },
  { id: 'prod', label: 'Type of productions', span: true, type: 'input' },
  {
    id: 'systems',
    label: 'Systems and protocols you use',
    span: true,
    type: 'input'
  },
  {
    id: 'availability',
    label: 'Can you test for 60–90 minutes in the next two weeks?',
    span: true,
    type: 'select',
    options: [
      'Yes, within two weeks',
      'Yes, but later than two weeks',
      'Not sure yet'
    ]
  },
  {
    id: 'problem',
    label: 'What would you test with Showmesh?',
    span: true,
    type: 'textarea'
  }
];

const faqs = [
  {
    q: 'What is Showmesh?',
    a: 'Showmesh is a Windows-native realtime show automation workspace, currently in beta. It brings media playback, realtime graphics control, control signals and external systems into one cue-based operating model.'
  },
  {
    q: 'Who is Showmesh for?',
    a: 'Showmesh is intended for show operators, technical directors, designers, programmers, venues and production teams working across theatre, concerts, installations, events and other live experiences.'
  },
  {
    q: 'Is Showmesh available now?',
    a: 'Showmesh is in beta, with a Windows installer available to early-access operators and teams. Because the beta is still changing, rehearse the exact build, media and control path you will use in a show.'
  },
  {
    q: 'Is Showmesh only for Windows?',
    a: 'The current product direction is Windows-first. This allows Showmesh to focus on native Windows media, graphics, audio and output workflows, including technologies commonly used in Windows-based production systems.'
  },
  {
    q: 'What can Showmesh control?',
    a: 'Showmesh controls media, outputs, control connections, realtime engines and other show systems. Capabilities and integrations are labelled by state—core in the beta, planned or exploratory—so nothing is presented as more finished than it is.'
  },
  {
    q: 'How does the cue model work?',
    a: 'Showmesh separates resources, actions and triggers. A resource defines what can be controlled, an action defines what changes and a trigger defines when it happens. Native media playback remains part of the cue lifecycle.'
  },
  {
    q: 'Does Showmesh support OSC and MIDI?',
    a: 'Yes. In the current beta you can send OSC messages and fades, send MIDI note, CC, program and MSC, take OSC and MIDI input, and map GO and PANIC with MIDI Learn.'
  },
  {
    q: 'Does Showmesh support NDI and Spout?',
    a: 'Yes—NDI and Spout output work on Windows in the current beta. NDI requires the NDI runtime; Spout shares GPU textures between applications.'
  },
  {
    q: 'Can I suggest an integration or workflow?',
    a: 'Yes. Early product conversations are specifically intended to identify the combinations of media, control and realtime systems that matter most in real productions.'
  }
];

const fmt = (sec: number) => {
  const s = Math.max(0, sec);
  const m = Math.floor(s / 60);
  const r = Math.floor(s % 60);
  return `${m}:${String(r).padStart(2, '0')}`;
};

// Initial demo state (matches the client controller: index 1, progress 20%).
const startIndex = 1;
const startProgress = 20;
const startNext = (startIndex + 1) % cues.length;
const startCur = cues[startIndex];
const startNextCue = cues[startNext];
const cueData = JSON.stringify(
  cues.map((c) => ({ num: c.num, name: c.name, dur: c.dur, intent: c.intent }))
);
---

<BaseLayout
  title="Showmesh — Run media, realtime systems and control from one show sequence."
  description="Showmesh is a Windows-native show automation workspace. Bring playback, realtime graphics, control signals and external systems into one cue-based workflow."
>
  <SiteNav />
  <main id="main-content" data-cues={cueData}>
    <!-- HERO -->
    <section class="hero">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="hero__copy">
        <img
          class="hero__logo"
          src="/showmesh-logo-mark-animated.svg"
          alt=""
          aria-hidden="true"
          width="120"
          height="99"
        />
        <h1>A cue playback engine for Windows.</h1>
        <p>
          Video, audio, images and text on a native C++ engine — plus OSC, MIDI,
          LTC/MTC timecode and NDI/Spout output to drive the rest of the rig.
          The editor is a separate process: closing it does not stop the show.
        </p>
        <div class="hero__actions">
          <a class="btn-solid" href="/download">Download the beta</a>
          <a
            class="btn-outline"
            href="https://manual.showmesh.app"
            rel="noopener">Read the manual</a
          >
        </div>
        <p class="hero__meta">
          <span class="mono">v0.1.0-beta.6</span> · Windows 10/11 ·
          <span class="hero__meta-warn"
            >installer is unsigned, SmartScreen will warn</span
          >
        </p>
      </div>

      <!-- Transport strip — mirrors editor/src/renderer/v2/components/
           Transport.tsx in v0.1.0-beta.6: GO carries what it will fire, STOP
           counts its blast radius, NEXT states the fired cue's intent. -->
      <div class="transport" data-transport>
        <div class="transport__now">
          <div class="transport__now-head">
            <span class="dot dot--playing" aria-hidden="true"></span>
            <span class="mono transport__cur-num" data-cur-num
              >{startCur.num}</span
            >
            <span class="transport__cur-name" data-cur-name
              >{startCur.name}</span
            >
            <span class="transport__time">
              <span class="mono" data-cur-elapsed
                >{fmt((startProgress / 100) * startCur.dur)}</span
              >
              <span class="mono transport__dur" data-cur-dur
                >/ {fmt(startCur.dur)}</span
              >
            </span>
          </div>
          <div class="transport__bar">
            <i data-cur-bar style={`width:${startProgress}%`}></i>
          </div>
        </div>
        <div class="transport__next">
          <div class="transport__next-head">
            <span class="transport__next-label">Next</span>
            <span class="mono transport__next-num" data-next-num
              >{startNextCue.num}</span
            >
            <span class="transport__next-name" data-next-name
              >{startNextCue.name}</span
            >
          </div>
          <span class="mono transport__next-intent">
            <span class="transport__next-caret" aria-hidden="true">▸</span>
            <span data-next-intent>{startNextCue.intent}</span>
          </span>
        </div>
        <div class="transport__controls">
          <button type="button" class="stop-btn" data-stop>
            <span aria-hidden="true">■</span>
            <b class="mono">STOP</b>
          </button>
          <button type="button" class="go-btn" data-go>
            <span class="mono go-btn__word">GO</span>
            <span class="go-btn__target" data-go-target
              >{startNextCue.num} · {startNextCue.name}</span
            >
          </button>
          <button type="button" class="panic-btn" data-panic>
            <span aria-hidden="true">⚠</span>
            <b class="mono">PANIC</b>
          </button>
        </div>
      </div>
    </section>

    <!-- MODEL -->
    <section id="model" class="band band--panel reveal">
      <div class="wrap center">
        <div class="eyebrow eyebrow--ready">Resource → Action → Trigger</div>
        <h2 class="h2-center">One model behind every cue.</h2>
        <div class="model">
          {
            model.map((m, i) => (
              <>
                {i > 0 && (
                  <div class="model__arrow" aria-hidden="true">
                    →
                  </div>
                )}
                <article class="card model__card">
                  <div class="model__label" style={`color:${m.color}`}>
                    {m.label}
                  </div>
                  <h3>{m.title}</h3>
                  <p>{m.copy}</p>
                  <p class="mono model__note">{m.note}</p>
                </article>
              </>
            ))
          }
        </div>
        <div class="model__params">
          <div class="model__params-row">
            <span class="model__params-label">Animatable parameters</span>
            <span class="model__params-list">
              {
                params.map((p, i) => (
                  <>
                    {i > 0 && <span class="model__sep"> · </span>}
                    <span>{p}</span>
                  </>
                ))
              }
            </span>
          </div>
          <div class="model__params-row">
            <span class="model__params-label">Addressable live</span>
            <span class="mono model__addr"
              >/resource/&#123;id&#125;/opacity &nbsp;
              /cue/&#123;id&#125;/volume</span
            >
          </div>
        </div>
        <p class="lead lead--center note">
          A media cue plays because the cue lifecycle plays it, not because you
          added a Play action. Actions are what you build around that lifecycle.
        </p>
      </div>
    </section>

    <!-- OPERATOR -->
    <section id="operator" class="band reveal">
      <div class="wrap">
        <div class="center intro">
          <div class="eyebrow eyebrow--playing">Under pressure</div>
          <h2 class="h2-center">What the operator can rely on.</h2>
          <p class="lead lead--center">
            A show-control system earns trust by being specific about what it is
            doing — and about what has stopped working.
          </p>
        </div>
        <div class="opcols">
          {
            operator.map((col) => (
              <article class="opcol">
                <h3 class="opcol__title" style={`color:${col.color}`}>
                  {col.title}
                </h3>
                <ul class="opcol__list">
                  {col.items.map((item) => (
                    <li set:html={item} />
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- EDITOR -->
    <section id="workspace" class="band reveal">
      <div class="wrap">
        <div class="center intro">
          <div class="eyebrow eyebrow--live">v0.1.0-beta.6</div>
          <h2 class="h2-center">The editor.</h2>
          <p class="lead lead--center">
            Cue list, transport and live system state, as the current beta draws
            them. Click a cue to arm it, or press GO.
          </p>
        </div>

        <figure class="appwindow" data-ui-window>
          <figcaption class="appwindow__bar">
            <span class="appwindow__dots" aria-hidden="true"
              ><i></i><i></i><i></i></span
            >
            <span class="appwindow__title">Showmesh — Hamlet — Act I.show</span>
            <a
              class="appwindow__open"
              href="/showmesh-ui.html"
              target="_blank"
              rel="noopener">Open full screen ↗</a
            >
          </figcaption>
          <div class="appwindow__viewport" data-ui-viewport>
            <!-- The editor's own layout has a 1180px floor, so a phone gets
                 the link rather than an unreadable postage stamp. -->
            <a
              class="appwindow__narrow"
              href="/showmesh-ui.html"
              target="_blank"
              rel="noopener"
              data-ui-narrow
            >
              <span class="appwindow__narrow-title">Showmesh — Operator</span>
              <span class="appwindow__narrow-note"
                >The editor needs a wide screen. Open it full screen ↗</span
              >
            </a>
            <iframe
              class="appwindow__frame"
              title="Showmesh editor — cue list, transport and system state"
              data-ui-frame
              loading="lazy"
              width="1280"
              height="800"></iframe>
          </div>
        </figure>
      </div>
    </section>

    <!-- REACTIVE -->
    <section class="band band--panel reveal">
      <div class="wrap grid-2 grid-2--center">
        <div>
          <div class="eyebrow eyebrow--live">Reactive triggers</div>
          <h2>Live input can drive a parameter while the cue runs.</h2>
          <p class="lead">
            Three of the nine triggers are reactive — OSC, MIDI CC and Manual.
            They arm when the cue starts playing and can fire repeatedly until
            it stops.
          </p>
          <p class="lead">
            Press <span class="mono">◎ Learn</span> on an action, move the controller,
            and it binds that channel and CC. GO and PANIC learn the same way; over
            OSC they are <span class="mono">/go</span> and{' '}
            <span class="mono">/panic</span>.
          </p>
          <p class="lead lead--accent">
            If chased timecode drops out, the internal generator freewheels from
            the last frame, so timecode-armed cues keep firing through the gap.
          </p>
        </div>
        <div class="maps">
          <div class="maps__label">Example mappings</div>
          {
            mappings.map((m) => (
              <div class="maps__row">
                <span class="maps__kind" style={`color:${m.color}`}>
                  {m.kind}
                </span>
                <span class="mono maps__from">{m.from}</span>
                <span class="maps__arrow" aria-hidden="true">
                  →
                </span>
                <span class="mono maps__to">{m.to}</span>
                <span class="maps__note">{m.note}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ENGINE -->
    <section class="band reveal">
      <div class="wrap">
        <div class="center intro">
          <div class="eyebrow eyebrow--ready">Native engine</div>
          <h2 class="h2-center">The engine owns the show.</h2>
          <p class="lead lead--center">
            Playback, timing and show state live in a separate native C++
            process. The editor is a protocol client that draws the interface,
            and a headless runtime runs shows with no interface at all.
          </p>
        </div>
        <div class="cards cards--4">
          {
            engine.map((e) => (
              <article class="card card--sm">
                <h3>{e.title}</h3>
                <p>{e.copy}</p>
              </article>
            ))
          }
        </div>
        <div class="evidence">
          <div class="evidence__row">
            <span class="evidence__label evidence__label--info">Recovery</span>
            <p>
              Documents are op-based, journalled and saved atomically, so a
              crash leaves the show recoverable. The engine runs under a
              watchdog that restarts it after an abnormal exit and gives up on a
              crash loop rather than thrashing. A fault writes a minidump, a log
              and a report bundle to the operator’s own disk — offline, no
              server involved.
            </p>
          </div>
          <div class="evidence__row">
            <span class="evidence__label evidence__label--ok">Measured</span>
            <p>
              A six-hour operator soak at 3440×1440 with NDI and Spout running,
              on GPU decode: no leaks, no handle growth, zero underruns, and a
              monitor topology change recovered without a restart.
            </p>
          </div>
          <div class="evidence__row">
            <span class="evidence__label evidence__label--gap">Not yet</span>
            <p>
              A real GPU device loss. A monitor power-cycle is a topology
              change, not a device loss, so that path remains untested.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- USE CASES -->
    <section class="band band--panel reveal">
      <div class="wrap">
        <div class="center intro">
          <div class="eyebrow eyebrow--live">
            Different rooms. One operating model.
          </div>
          <h2 class="h2-center">
            Made for shows that combine media, timing and control.
          </h2>
        </div>
        <div class="cards cards--auto">
          {
            useCases.map((u) => (
              <article class="card card--sm">
                <h3>{u.title}</h3>
                <p>{u.copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- INTEGRATIONS -->
    <section id="integrations" class="band reveal">
      <div class="wrap">
        <div class="center intro">
          <div class="eyebrow eyebrow--ready">
            Work with the systems around you
          </div>
          <h2 class="h2-center">Connect by role, not by logo count.</h2>
          <p class="lead lead--center">
            The purpose of an integration is not to make a longer compatibility
            list. It is to make a real production workflow simpler, clearer and
            more dependable.
          </p>
        </div>
        <div class="chips">
          {
            integrations.map((i) => (
              <span class="chip">
                <span class="chip__name">{i.name}</span>
                <span class="chip__status" style={`color:${i.color}`}>
                  {i.status}
                </span>
              </span>
            ))
          }
        </div>
        <p class="fine">
          Availability is labelled clearly as core, planned or exploratory, so
          beta features are never presented as more finished than they are.
